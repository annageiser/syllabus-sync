# Syllabus-Sync Backend Configuration
# Copy this file to .env and update with your values

# ============================================
# AI Extraction Configuration
# ============================================

# OPTION 1: Google AI SDK (FREE Tier, but requires AI Studio access)
# Get a free key at: https://aistudio.google.com/app/apikey (if available in your country)
GEMINI_API_KEY=AIzaSyAszd6rX-QMK-Bot23FEOlnl85ACtAfDqM

# OPTION 2: Google Cloud / Vertex AI (Requires Billing enabled)
GOOGLE_CLOUD_PROJECT=syllabus-sync-486913

# OPTION 3: OFFLINE MODE (DEFAULT, FREE, NO SETUP)
# If both above are empty, the app uses built-in heuristic extraction.
# This works 100% offline and is free forever.

# Vertex AI region (default: us-central1)
VERTEX_AI_LOCATION=us-central1

# Gemini model to use (for Google AI SDK)
# Options: gemini-1.5-flash, gemini-2.0-flash-exp, gemini-3-flash-preview
GEMINI_MODEL=gemini-2.5-flash-preview

# ============================================
# Server Configuration
# ============================================

# Host to bind the server to
# Use 0.0.0.0 to allow external connections, 127.0.0.1 for local only
BACKEND_HOST=0.0.0.0

# Port to run the backend server on
BACKEND_PORT=8000

# ============================================
# CORS Configuration
# ============================================

# Allowed origins for CORS (comma-separated)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Application Settings
# ============================================

# Default year to assume when parsing dates without a year
DEFAULT_YEAR=2026

# Whether to automatically clean up temporary files after processing
TEMP_FILE_CLEANUP=true

# ============================================
# Debugging
# ============================================

# Enable debug mode (prints additional logs)
DEBUG=true
