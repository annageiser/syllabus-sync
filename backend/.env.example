# Syllabus-Sync Backend Configuration
# Copy this file to .env and update with your values

# ============================================
# Google Cloud / Vertex AI Configuration
# ============================================

# Your Google Cloud Project ID
# Get this from: https://console.cloud.google.com/
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI region (default: us-central1)
# See available regions: https://cloud.google.com/vertex-ai/docs/general/locations
VERTEX_AI_LOCATION=us-central1

# Vertex AI model to use for parsing
VERTEX_AI_MODEL=gemini-1.5-flash-001

# ============================================
# Server Configuration
# ============================================

# Host to bind the server to
# Use 0.0.0.0 to allow external connections, 127.0.0.1 for local only
BACKEND_HOST=0.0.0.0

# Port to run the backend server on
BACKEND_PORT=8000

# ============================================
# CORS Configuration
# ============================================

# Allowed origins for CORS (comma-separated)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Application Settings
# ============================================

# Default year to assume when parsing dates without a year
DEFAULT_YEAR=2026

# Whether to automatically clean up temporary files after processing
TEMP_FILE_CLEANUP=true

# ============================================
# Debugging
# ============================================

# Enable debug mode (prints additional logs)
DEBUG=false
